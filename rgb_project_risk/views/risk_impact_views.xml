<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rgb_risk_impact_list" model="ir.ui.view">
        <field name="name">rgb.risk.impact.list</field>
        <field name="model">rgb.risk.impact</field>
        <field name="arch" type="xml">
            <list string="Impact Assessments" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rgb_risk_impact_form" model="ir.ui.view">
        <field name="name">rgb.risk.impact.form</field>
        <field name="model">rgb.risk.impact</field>
        <field name="arch" type="xml">
            <form string="Impact Assessment">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rgb_risk_impact" model="ir.actions.act_window">
        <field name="name">Impact Assessments</field>
        <field name="res_model">rgb.risk.impact</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create impact assessment values
            </p>
        </field>
    </record>
</odoo>
