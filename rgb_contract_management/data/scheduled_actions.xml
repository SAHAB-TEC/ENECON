<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_contract_guarantee_reminder" model="ir.cron">
        <field name="name">Contract: Performance Guarantee Reminder</field>
        <field name="model_id" ref="model_rgb_contract"/>
        <field name="state">code</field>
        <field name="code">model._cron_performance_guarantee_reminder()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_performance_guarantee_group_reminder" model="ir.cron">
        <field name="name">Contract: Performance Guarantee Group Reminder (10 days)</field>
        <field name="model_id" ref="model_rgb_contract"/>
        <field name="state">code</field>
        <field name="code">model._cron_performance_guarantee_group_reminder()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_contract_expiry_reminder" model="ir.cron">
        <field name="name">Contract: Expiry Reminder (10 days)</field>
        <field name="model_id" ref="model_rgb_contract"/>
        <field name="state">code</field>
        <field name="code">model._cron_contract_expiry_reminder()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_advance_payment_reminder" model="ir.cron">
        <field name="name">Contract: Advance Payment Reminder (10 days)</field>
        <field name="model_id" ref="model_rgb_contract"/>
        <field name="state">code</field>
        <field name="code">model._cron_advance_payment_reminder()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
