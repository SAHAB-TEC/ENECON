<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_contract" model="ir.ui.view">
        <field name="name">account.move.form.contract</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="after">
                <field name="payment_readiness_state" widget="statusbar"
                       statusbar_visible="in_progress,ready_for_payment"
                       invisible="move_type == 'entry'"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="contract_id"
                       domain="[('state', 'in', ('approved', 'in_progress', 'done'))]"
                       options="{'no_create': True}"/>
                <field name="contract_code" readonly="1" invisible="not contract_id"/>
                <field name="indicative_number" readonly="1" invisible="not contract_id"/>
                <field name="contract_type" invisible="1"/>
                <field name="contract_manual_exchange_rate" readonly="1"
                       invisible="not contract_id"/>
            </xpath>
            <xpath expr="//group[hasclass('oe_invoice_lines_tab')]" position="after">
                <group string="Payment Currency Split" invisible="not contract_id">
                    <field name="currency_split_percentage_total" readonly="1"
                           decoration-danger="currency_split_percentage_total != 100 and currency_split_percentage_total != 0"/>
                    <field name="currency_split_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="currency_id"/>
                            <field name="exchange_rate"/>
                            <field name="percentage"/>
                            <field name="amount" readonly="1"/>
                        </list>
                    </field>
                    <field name="dollar_percentage" invisible="1"/>
                    <field name="libya_dinar_percentage" invisible="1"/>
                    <field name="usd_amount" invisible="1"/>
                    <field name="lyd_amount" invisible="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_tree_contract" model="ir.ui.view">
        <field name="name">account.invoice.tree.contract</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='status_in_payment']" position="before">
                <field name="contract_id" optional="hide"/>
                <field name="contract_code" optional="hide"/>
                <field name="indicative_number" optional="show"/>
                <field name="payment_readiness_state" optional="show"
                       widget="badge"
                       decoration-warning="payment_readiness_state == 'in_progress'"
                       decoration-success="payment_readiness_state == 'ready_for_payment'"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_contract" model="ir.ui.view">
        <field name="name">account.invoice.select.contract</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="contract_id"/>
                <field name="contract_code"/>
                <field name="indicative_number"/>
                <field name="payment_readiness_state"/>
            </xpath>
            <xpath expr="//filter[@name='draft']" position="after">
                <separator/>
                <filter name="payment_in_progress" string="In Progress"
                        domain="[('payment_readiness_state', '=', 'in_progress')]"/>
                <filter name="payment_ready" string="Ready for Payment"
                        domain="[('payment_readiness_state', '=', 'ready_for_payment')]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter name="group_contract" string="Contract"
                        context="{'group_by': 'contract_id'}"/>
                <filter name="group_indicative_number" string="Indicative Number"
                        context="{'group_by': 'indicative_number'}"/>
                <filter name="group_payment_readiness" string="Payment Readiness"
                        context="{'group_by': 'payment_readiness_state'}"/>
            </xpath>
        </field>
    </record>
</odoo>
