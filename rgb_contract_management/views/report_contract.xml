<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_rgb_contract" model="ir.actions.report">
        <field name="name">Contract</field>
        <field name="model">rgb.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rgb_contract_management.report_rgb_contract_document</field>
        <field name="report_file">rgb_contract_management.report_rgb_contract_document</field>
        <field name="print_report_name">'Contract - %s' % (object.contract_code or object.name)</field>
        <field name="binding_model_id" ref="model_rgb_contract"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_rgb_contract_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="mb-3">عقد / Contract</h2>
                        <table class="table table-sm table-borderless mb-4" style="width:100%">
                            <tr>
                                <td style="width:35%"><strong>رقم العقد</strong></td>
                                <td><span t-field="o.name"/></td>
                            </tr>
                            <tr t-if="o.contract_code">
                                <td><strong>رقم العقد (Contract No)</strong></td>
                                <td><span t-field="o.contract_code"/></td>
                            </tr>
                            <tr t-if="o.indicative_number">
                                <td><strong>الرقم الإشاري</strong></td>
                                <td><span t-field="o.indicative_number"/></td>
                            </tr>
                            <tr t-if="o.contract_name">
                                <td><strong>اسم العقد</strong></td>
                                <td><span t-field="o.contract_name"/></td>
                            </tr>
                            <tr>
                                <td><strong>النوع</strong></td>
                                <td><span t-field="o.contract_type"/></td>
                            </tr>
                            <tr>
                                <td><strong>المقاول / العميل</strong></td>
                                <td><span t-field="o.partner_id"/></td>
                            </tr>
                            <tr t-if="o.date_start or o.date_end">
                                <td><strong>الفترة</strong></td>
                                <td>
                                    <span t-field="o.date_start"/> —
                                    <span t-field="o.date_end"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>قيمة العقد</strong></td>
                                <td>
                                    <span t-field="o.contract_value_currency"
                                          t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>الحالة</strong></td>
                                <td><span t-field="o.state"/></td>
                            </tr>
                        </table>

                        <t t-if="o.contract_line_ids">
                            <h4 class="mt-4">بنود العقد</h4>
                            <table class="table table-sm o_main_table">
                                <thead>
                                    <tr>
                                        <th>الوصف</th>
                                        <th class="text-end">الكمية</th>
                                        <th class="text-end">السعر</th>
                                        <th class="text-end">الإجمالي</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.contract_line_ids" t-as="line">
                                        <td><span t-field="line.name"/></td>
                                        <td class="text-end"><span t-field="line.quantity"/></td>
                                        <td class="text-end">
                                            <span t-field="line.price_unit"
                                                  t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.price_subtotal"
                                                  t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
