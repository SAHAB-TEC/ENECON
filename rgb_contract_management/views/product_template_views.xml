<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_contract_deductions" model="ir.ui.view">
        <field name="name">product.template.form.contract.deductions</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="inside">
                <group string="Contract Deductions" name="contract_deductions">
                    <group>
                        <field name="is_contract_advance_payment"/>
                        <field name="contract_advance_payment_percent"
                               invisible="not is_contract_advance_payment"/>
                    </group>
                    <group>
                        <field name="is_contract_retention_guarantee"/>
                        <field name="contract_retention_percent"
                               invisible="not is_contract_retention_guarantee"/>
                    </group>
                    <group>
                        <field name="is_contract_performance_guarantee"/>
                        <field name="contract_performance_guarantee_percent"
                               invisible="not is_contract_performance_guarantee"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
