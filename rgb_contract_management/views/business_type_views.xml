<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rgb_contract_business_type_list" model="ir.ui.view">
        <field name="name">rgb.contract.business.type.list</field>
        <field name="model">rgb.contract.business.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rgb_contract_business_type_form" model="ir.ui.view">
        <field name="name">rgb.contract.business.type.form</field>
        <field name="model">rgb.contract.business.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rgb_contract_business_type" model="ir.actions.act_window">
        <field name="name">Business Types</field>
        <field name="res_model">rgb.contract.business.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
