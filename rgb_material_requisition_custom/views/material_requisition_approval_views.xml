<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_material_requisition_approval_list_well_rig" model="ir.ui.view">
        <field name="name">material.requisition.approval.list.well.rig</field>
        <field name="model">material.requisition.approval</field>
        <field name="inherit_id" ref="material_requisition_and_approval.view_material_requisition_approval_tree"/>
        <field name="arch" type="xml">
            <field name="requisition_id" position="after">
                <field name="well_id" optional="show"/>
                <field name="rig_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_material_requisition_approval_form_well_rig" model="ir.ui.view">
        <field name="name">material.requisition.approval.form.well.rig</field>
        <field name="model">material.requisition.approval</field>
        <field name="inherit_id" ref="material_requisition_and_approval.view_material_requisition_approval_form"/>
        <field name="arch" type="xml">
            <field name="requisition_id" position="after">
                <field name="well_id"/>
                <field name="rig_id"/>
            </field>
        </field>
    </record>

</odoo>
