<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_material_requisition_well_rig" model="ir.ui.view">
        <field name="name">stock.picking.form.material.requisition.well.rig</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="project_id" options="{'no_create': True}"/>
                <field name="analytic_account_id" options="{'no_create': True}"/>
                <field name="well_id"/>
                <field name="rig_id"/>
            </field>
            <xpath expr="//page[@name='operations']//field[@name='product_id']" position="after">
                <field name="project_id" optional="show"/>
                <field name="analytic_account_id" optional="show"/>
                <field name="well_id" optional="hide"/>
                <field name="rig_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_well_rig" model="ir.ui.view">
        <field name="name">stock.move.form.well.rig</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <field name="reference" position="after">
                <field name="project_id"/>
                <field name="analytic_account_id"/>
                <field name="well_id"/>
                <field name="rig_id"/>
            </field>
        </field>
    </record>

    <record id="view_move_tree_well_rig" model="ir.ui.view">
        <field name="name">stock.move.list.well.rig</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="project_id" optional="hide"/>
                <field name="well_id" optional="show"/>
                <field name="rig_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_move_search_well_rig" model="ir.ui.view">
        <field name="name">stock.move.search.well.rig</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_search"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="project_id"/>
                <field name="well_id"/>
                <field name="rig_id"/>
            </field>
        </field>
    </record>

    <record id="view_purchase_order_form_material_requisition_well_rig" model="ir.ui.view">
        <field name="name">purchase.order.form.material.requisition.well.rig</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="project_id" options="{'no_create': True}"/>
                <field name="analytic_account_id" options="{'no_create': True}"/>
                <field name="well_id"/>
                <field name="rig_id"/>
            </field>
        </field>
    </record>

</odoo>
