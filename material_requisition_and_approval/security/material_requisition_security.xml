<odoo>
        
        <record id="rule_employee_own_requests" model="ir.rule">
            <field name="name">Employee: Own Requests</field>
            <field name="model_id" ref="material_requisition_and_approval.model_material_requisition"/>
            <field name="domain_force">['|', ('requester_id.id', '=', user.id), ('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_employee_own_request_lines" model="ir.rule">
            <field name="name">Employee: Own Request Lines</field>
            <field name="model_id" ref="material_requisition_and_approval.model_material_requisition_line"/>
            <field name="domain_force">['|', '|',
            ('requisition_id.requester_id.id', '=', user.id), 
            ('requisition_id.employee_id.user_id', '=', user.id),
            ('requisition_id.approval_ids.approver_ids', 'in', user.id)]</field>

            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>


        <record id="rule_department_manager_access" model="ir.rule">
            <field name="name">Department Manager: Own Dept Requests</field>
            <field name="model_id" ref="material_requisition_and_approval.model_material_requisition"/>
            <field name="domain_force">[('department_id.manager_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
        </record>

        <record id="rule_stock_manager_access" model="ir.rule">
            <field name="name">Stock Manager: Assigned</field>
            <field name="model_id" ref="material_requisition_and_approval.model_material_requisition"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
        </record>

        <record id="rule_stock_manager_access_lines" model="ir.rule">
            <field name="name">Stock Manager: Assigned</field>
            <field name="model_id" ref="material_requisition_and_approval.model_material_requisition_line"/>
            <field name="domain_force">[(1,"=",1)]</field>
            <field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
        </record>


        <record id="rule_approver_level_access" model="ir.rule">
            <field name="name">Approver: Approver Access</field>
            <field name="model_id" ref="model_material_requisition"/>
            <field name="domain_force">[('approval_ids.approver_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('material_requisition_and_approval.group_requisition_approver'))]"/>
        </record>

       
       
        <record id="rule_store_checker_access" model="ir.rule">
            <field name="name">Store Checker: Can View Assigned</field>
            <field name="model_id" ref="model_material_requisition"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('material_requisition_and_approval.group_store_checker'))]"/>
        </record>

        <record id="rule_store_checker_access_lines" model="ir.rule">
            <field name="name">Store Checker: Can View Assigned</field>
            <field name="model_id" ref="material_requisition_and_approval.model_material_requisition_line"/>
            <field name="domain_force">[(1,"=",1)]</field>
            <field name="groups" eval="[(4, ref('material_requisition_and_approval.group_store_checker'))]"/>
        </record>


        <record id="rule_requisition_officer_full_access" model="ir.rule">
            <field name="name">Requisition Officer: Full</field>
            <field name="model_id" ref="material_requisition_and_approval.model_material_requisition"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('material_requisition_and_approval.group_requisition_officer'))]"/>
        </record>



        <record id="rule_requisition_officer_full_access_lines" model="ir.rule">
            <field name="name">Requisition Officer: Full lines</field>
            <field name="model_id" ref="material_requisition_and_approval.model_material_requisition_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('material_requisition_and_approval.group_requisition_officer'))]"/>
        </record>



</odoo>

