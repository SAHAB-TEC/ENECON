<odoo>

        <record id="material_requisition_and_approval_security_category" model="ir.module.category">
            <field name="name">Material Requisition and Approval</field>
        </record>

        <record id="group_requisition_approver" model="res.groups">
            <field name="name">Requisition Approver</field>
            <field name="category_id" ref="material_requisition_and_approval_security_category"/>
        </record>

        <record id="hr.group_hr_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('material_requisition_and_approval.group_requisition_approver'))]"/>
        </record>
    
        <record id="group_store_checker" model="res.groups">
            <field name="name">Store Checker</field>
            <field name="category_id" ref="material_requisition_and_approval_security_category"/>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        </record>

        <record id="group_requisition_officer" model="res.groups">
            <field name="name">Requisition Officer</field>
            <field name="category_id" ref="material_requisition_and_approval_security_category"/>
            <field name="implied_ids" eval="[
                (4,ref('stock.group_stock_manager')),
                (4,ref('hr.group_hr_manager')),
                (4,ref('material_requisition_and_approval.group_store_checker')),
                (4,ref('material_requisition_and_approval.group_requisition_approver')),
                (4,ref('base.group_user'))
            ]"/>

             <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />

        </record>

</odoo>