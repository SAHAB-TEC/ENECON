<odoo>
    <record id="action_location_role_setup" model="ir.actions.act_window">
        <field name="name">Location Setup</field>
        <field name="res_model">stock.location.role.config</field>
        <field name="view_mode">list,form</field>
    </record> 
    
    <record id="view_stock_location_role_config_list" model="ir.ui.view">
        <field name="name">stock.location.role.config.list</field>
        <field name="model">stock.location.role.config</field>
        <field name="arch" type="xml">
            <list string="Location Role Configurations">
                <field name="location_id"/>
                <field name="store_checker_ids" widget="many2many_tags"/>
                <field name="stock_manager_ids" widget="many2many_tags"/>
                <field name="replenishment_user_id"/>
                <field name="remarks_required"/>
            </list>
        </field>
    </record>

    <record id="view_stock_location_role_config_form" model="ir.ui.view">
        <field name="name">stock.location.role.config.form</field>
        <field name="model">stock.location.role.config</field>
        <field name="arch" type="xml">
            <form string="Stock Location Role Configuration">
            <sheet>
                <group>
                    <field name="location_id"/>
                    <field name="remarks_required"/>
                </group>
                <group string="Users">
                    <field name="store_checker_ids" widget="many2many_tags" 
                                domain="[('share', '=', False)]"
                    />
                    <field name="stock_manager_ids" widget="many2many_tags"
                                domain="[('share', '=', False)]"
                    />
                    <field name="replenishment_user_id"
                                domain="[('share', '=', False)]"
                    />
                </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stock_location_role_config_search" model="ir.ui.view">
        <field name="name">stock.location.role.config.search</field>
        <field name="model">stock.location.role.config</field>
        <field name="arch" type="xml">
            <search >
                <field name="location_id"/>
                <field name="replenishment_user_id"/>
                <field name="remarks_required"/>
            </search>
        </field>
    </record>

</odoo>