    <record model="ir.sequence" id="seq_requests">
        <field name="name">Requests Sequence</field>
        <field name="code">material.requisition.sequence</field>
        <field name="prefix">REQ/%(year)s/</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="action_my_requests" model="ir.actions.act_window">
        <field name="name">My Requests</field>
        <field name="res_model">material.requisition</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="search_view_id" ref="material_requisition_and_approval.view_material_requisition_my_requests_search"/>
        <field name="domain">['|', '|', ('employee_id.user_id', '=', uid), ('requester_id', '=', uid), ('approval_ids.approver_ids', 'in', uid)]</field>
        <field name="context">{'search_default_my_requests':True}</field>
    </record>

    <record id="action_all_requests" model="ir.actions.act_window">
        <field name="name">All Requests</field>
        <field name="res_model">material.requisition</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="domain">[('state_code','!=','draft')]</field>
        <field name="context">{}</field>
    </record>


</odoo>
