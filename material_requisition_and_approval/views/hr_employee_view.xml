<odoo>
    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.hr.work.location</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_material_requisitions" type="object" class="oe_stat_button" icon="fa-list">
                    <field name="material_requisition_count" widget="statinfo" string="Requisitions"/>
                </button>
            </xpath>
            
            <xpath expr="//field[@name='work_location_id']" position="after">
                <field name="default_location_id"/>
            </xpath>
            
            <xpath expr="//header" position="inside">
                <button name="action_create_material_requisition" string="Create Material Requisition" 
                        type="object" class="oe_highlight" groups="base.group_user"/>
            </xpath>
        </field>
    </record>
</odoo>
