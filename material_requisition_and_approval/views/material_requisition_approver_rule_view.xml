<odoo>
    <!-- Action -->
    <record id="action_approval_rules" model="ir.actions.act_window">
        <field name="name">Approval Rules</field>
        <field name="res_model">material.requisition.approver.rule</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
    <record id="view_material_requisition_approver_rule_list" model="ir.ui.view">
        <field name="name">material.requisition.approver.rule.list</field>
        <field name="model">material.requisition.approver.rule</field>
        <field name="arch" type="xml">
            <list string="Approval Rules">
                <field name="name"/>
                <field name="approval_rule_type"/>
                <field name="approver_type" />
                <field name="store_check_required"/>
                <field name="stock_manager_required"/>
                <field name="po_delivery_to_employee_location"/>
                <field name="auto_create_dispatch"/>
                <field name="require_stock_manager_dispatch"/>
            </list>
        </field>
    </record>
    <record id="view_material_requisition_approver_rule_kanban" model="ir.ui.view">
        <field name="name">material.requisition.approver.rule.kanban</field>
        <field name="model">material.requisition.approver.rule</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" quick_create="false">
                <field name="approval_rule_type"/>
                <field name="request_type_id"/>
                <field name="employee_ids"/>
                <field name="department_ids"/>
                <field name="location_ids"/>
                <field name="store_check_required"/>
                <field name="approver_type" />
                <field name="stock_manager_required"/>
                <field name="auto_create_dispatch"/>
                <field name="name"/>
                <field name="approval_lines"/>
                <templates>
                    <t t-name="card">
                        <div class="p-2">
                            <div class="fw-bold fs-5 mb-1">
                                <field name="name"/>
                            </div>
                            <div class="mb-2 text-muted small">
                                <strong>Type:</strong> 
                                <field name="approval_rule_type"/> |
                                <strong>Request:</strong> 
                                <field name="request_type_id"/>
                                <strong>Approver Type:</strong> 
                                <field name="approver_type"/>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-2 small text-muted">
                                <t t-if="record.store_check_required.raw_value">
                                    <span class="badge rounded-pill bg-info">Store Check</span>
                                </t>
                                <t t-if="record.stock_manager_required.raw_value">
                                    <span class="badge rounded-pill bg-warning">Stock Manager</span>
                                </t>
                                <t t-if="record.auto_create_dispatch.raw_value">
                                    <span class="badge rounded-pill bg-success">Auto Dispatch</span>
                                </t>
                                <t t-if="record.require_stock_manager_dispatch.raw_value">
                                    <span class="badge rounded-pill bg-danger">SM Dispatch</span>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_material_requisition_approver_rule_form" model="ir.ui.view">
        <field name="name">material.requisition.approver.rule.form</field>
        <field name="model">material.requisition.approver.rule</field>
        <field name="arch" type="xml">
            <form string="Approval Rule">
                <sheet>
                    <group col="2">
                        <group string="Rule Configuration">
                            <field name="name"/>
                            <field name="approval_rule_type"/>
                            <field name="request_type_id" invisible="approval_rule_type != 'request_type'"/>
                            <field name="employee_ids" invisible="approval_rule_type != 'employee'" widget="many2many_tags"/>
                            <field name="department_ids" invisible="approval_rule_type != 'department'" widget="many2many_tags"/>
                            <field name="user_ids" invisible="approval_rule_type != 'employee/user/department'" widget="many2many_tags"/>
                            <field name="location_ids" invisible="approval_rule_type != 'location'" widget="many2many_tags"/>
                            <field name="approver_type" />
                        </group>
                        <!-- add domain select only internal user -->
                        <group string="Stock Configuration" >
                            <field name="store_check_required" readonly="auto_create_dispatch == True"/>
                            <field name="store_checker_ids" 
                                widget="many2many_tags" 
                                invisible="store_check_required == False"
                                readonly="auto_create_dispatch == True"
                                domain="[('share', '=', False)]"
                               />
                            <field name="stock_manager_required" readonly="auto_create_dispatch == True"/>
                            <field name="stock_manager_ids" 
                                widget="many2many_tags" invisible="stock_manager_required == False"
                                readonly="auto_create_dispatch == True"
                                domain="[('share', '=', False)]"
                                />
                        </group>
                    </group>
                    <group >
                        <group string="Dispatch Configuration">
                            <field name="auto_create_dispatch"
                                help="When enabled: after the store checker creates an internal transfer, it is automatically confirmed, stock reserved, and validated — no manual step needed. Disables store check and stock manager approval."
                                />
                            <field name="require_stock_manager_dispatch"
                                readonly="auto_create_dispatch == True"
                                help="When enabled: after the store checker creates an internal transfer, it is confirmed and stock reserved — but a stock manager must manually validate it before goods move."
                                />
                        </group>
                        <group string="Purchase Order Configuration">
                            <field 
                                name="po_delivery_to_employee_location"  
                                help="If enabled, RFQ will be deliver to employee location"/>
                                
                                <field name="default_location_id" 
                                invisible = "po_delivery_to_employee_location == False"
                                options="{'no_create': True}"/>            
                            </group>
                    </group>
                    <notebook>
                        <page string="Approval Lines" invisible="approver_type != 'manually_approved'">
                            <field name="approval_lines">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="user_ids" widget="many2many_tags" 
                                domain="[('share', '=', False)]"
                                    />
                                    <!-- <field name="level" /> -->
                                    <field name="required"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
