<odoo>

  
    <record id="view_form_material_requisition_dashboard" model="ir.ui.view">
        <field name="name">material.requisition.dashboard.form</field>
        <field name="model">material.requisition.dashboard</field>
        <field name="arch" type="xml">
        <form string="Requisition Dashboard">
            <sheet>
            <group>
                <group>
                <field name="name"/>
                <field name="operation_type"/>
                <field name="chart_type" />
                <field name="record_limit"/>
                <field name="date_group_by" invisible="chart_type != 'line'"/>
                </group>
                <group>
                    <field name="state_selections" invisible="operation_type != 'requisition_by_state'"/>
                    <field name="state_id"
                            invisible="operation_type != 'requisition_by_state' or state_selections != 'one'"/>
                    <field name="state_ids"
                            invisible="operation_type != 'requisition_by_state' or state_selections != 'more_than_one'" widget="many2many_tags"/>
                    <field name="request_type_id" invisible="operation_type != 'requisition_by_request_type'" />
                </group>
            </group>
            </sheet>
        </form>
        </field>
    </record>

    <record id="view_tree_material_requisition_dashboard" model="ir.ui.view">
        <field name="name">material.requisition.dashboard.list</field>
        <field name="model">material.requisition.dashboard</field>
        <field name="arch" type="xml">
            <list string="Requisition Dashboard">
                <field name="name"/>
                <field name="operation_type"/>
                <field name="chart_type"/>
                <!-- <field name="state_selections"/>
                <field name="state_id"/>
                <field name="state_ids" widget="many2many_tags"/> -->
            </list>
        </field>
    </record>

    <record id="view_material_requisition_dashboard_graph_form" model="ir.ui.view">
        <field name="name">material.requisition.dashboard.graph.form</field>
        <field name="model">material.requisition.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard Graph" class="mrd_fullscreen_form">
                <sheet>
                    <div class="mrd_fs_shell">
                        <div class="mrd_fs_header">
                            <div class="mrd_fs_header_left">
                                <span class="mrd_fs_eyebrow">Material Intelligence</span>
                                <field name="name" readonly="1" class="mrd_fs_title"/>
                                <p class="mrd_fs_subtitle">
                                    Review demand patterns, isolate emerging bottlenecks, and open the underlying requisitions directly from the chart.
                                </p>
                            </div>
                            <div class="mrd_fs_header_right">
                                <span class="mrd_fs_badge mrd_fs_badge_op">
                                    <field name="operation_type" readonly="1"/>
                                </span>
                                <span class="mrd_fs_badge mrd_fs_badge_chart">
                                    <field name="chart_type" readonly="1"/>
                                </span>
                            </div>
                        </div>

                        <div class="mrd_fs_content">
                            <div class="mrd_fs_main">
                                <div class="mrd_fs_chart_card oe_form_dashboard">
                                    <div class="mrd_fs_chart_card_top">
                                        <div>
                                            <span class="mrd_fs_section_label">Live Chart</span>
                                            <h2 class="mrd_fs_section_title">Interactive Requisition Breakdown</h2>
                                        </div>
                                        <div class="mrd_fs_chart_legend">
                                            <span class="mrd_legend_dot mrd_legend_primary"/>
                                            <span class="mrd_legend_label">Tap any data point to drill into matching records</span>
                                        </div>
                                    </div>
                                    <div class="mrd_fs_chart_shell">
                                        <field name="graph_data"
                                                widget="state_type_dashboard_graph"
                                                graph_type="bar"
                                                class="w-100 h-100"
                                                show_legend="true"
                                                invisible="chart_type == 'bar'"/>
                                        <field name="graph_data"
                                                widget="state_type_dashboard_graph"
                                                graph_type="bar"
                                                class="w-100 h-100"
                                                invisible="chart_type != 'bar'"/>
                                    </div>
                                </div>
                            </div>

                            <div class="mrd_fs_sidebar">
                                <div class="mrd_fs_filterbar">
                                    <div class="mrd_fs_filterbar_top">
                                        <span class="mrd_fs_section_label">Refine Window</span>
                                        <p class="mrd_fs_filter_copy">Choose a date range to refresh the visual trend for this dashboard block.</p>
                                    </div>
                                    <div class="mrd_fs_filter_group">
                                        <span class="o_form_label mrd_fs_filter_label">Start Date</span>
                                        <input type="date" class="mrd_fs_date_input mrd_fs_date_input_start"/>
                                    </div>
                                    <div class="mrd_fs_filter_group">
                                        <span class="o_form_label mrd_fs_filter_label">End Date</span>
                                        <input type="date" class="mrd_fs_date_input mrd_fs_date_input_end"/>
                                    </div>
                                </div>

                                <div class="mrd_insight_card mrd_fs_breakdown_card">
                                    <span class="mrd_insight_label">Full Breakdown</span>
                                    <p class="mrd_insight_sub">Each color below maps directly to a chart point in this widget.</p>
                                    <field name="graph_summary_html" widget="html" readonly="1" nolabel="1"/>
                                </div>

                                
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_material_requisition_dashboard_kanban" model="ir.ui.view">
        <field name="name">material.requisition.dashboard.kanban</field>
        <field name="model">material.requisition.dashboard</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_material_requisition_dashboard"
                create="false"
                quick_create="false">
                <field name="name"/>
                <field name="operation_type"/>
                <field name="state_selections"/>
                <field name="state_id"/>
                <field name="state_ids"/>
                <field name="graph_data"/>
                <field name="chart_type"/>

                <templates>
                    <t t-name="card">
                        <div t-attf-class="mrd_card mrd_card_#{record.operation_type.raw_value} mrd_chart_#{record.chart_type.raw_value}" t-attf-data-id="#{record.id.raw_value}">

                            <div class="mrd_card_header">
                                <div class="mrd_card_header_copy">
                                    <span class="mrd_card_eyebrow">Material Intelligence</span>
                                    <field name="name" class="mrd_card_title"/>
                                    <p class="mrd_card_description">
                                        <t t-if="record.operation_type.raw_value == 'requisition_by_state'">Track requisitions by workflow stage and compare movement over time.</t>
                                        <t t-elif="record.operation_type.raw_value == 'top_requested_products'">Spot high-demand items early and identify recurring pressure on stock.</t>
                                        <t t-elif="record.operation_type.raw_value == 'requisition_by_department'">Understand where demand is concentrated across business functions.</t>
                                        <t t-elif="record.operation_type.raw_value == 'requisition_by_request_type'">Monitor request categories and their recent operational rhythm.</t>
                                    </p>
                                </div>
                                <div class="mrd_card_header_meta">
                                    <span t-attf-class="mrd_badge mrd_badge_#{record.operation_type.raw_value}">
                                        <t t-if="record.operation_type.raw_value == 'requisition_by_state'">By State</t>
                                        <t t-elif="record.operation_type.raw_value == 'top_requested_products'">Top Products</t>
                                        <t t-elif="record.operation_type.raw_value == 'requisition_by_department'">By Department</t>
                                        <t t-elif="record.operation_type.raw_value == 'requisition_by_request_type'">Request Type</t>
                                    </span>
                                    <span class="mrd_chart_badge">
                                        <t t-if="record.chart_type.raw_value == 'bar'">Bar View</t>
                                        <t t-elif="record.chart_type.raw_value == 'line'">Line View</t>
                                        <t t-elif="record.chart_type.raw_value == 'pie'">Pie View</t>
                                        <t t-else="">Doughnut View</t>
                                    </span>
                                </div>
                            </div>

                            <div class="mrd_card_chart_shell">
                                <div class="mrd_card_chart">
                                    <field name="graph_data"
                                        widget="state_type_dashboard_graph"
                                        graph_type="bar"
                                        hide_axes="true"
                                        show_tooltip="true"
                                        class="w-100 h-100"/>
                                </div>
                                <div class="mrd_card_metric_strip">
                                    <span class="mrd_metric_label">Analytics Mode</span>
                                    <span class="mrd_metric_value">
                                        <t t-if="record.chart_type.raw_value == 'bar'">Comparative bars</t>
                                        <t t-elif="record.chart_type.raw_value == 'line'">Trend line</t>
                                        <t t-elif="record.chart_type.raw_value == 'pie'">Share of total</t>
                                        <t t-else="">Circular breakdown</t>
                                    </span>
                                </div>
                            </div>

                            <div class="mrd_card_footer">
                                <div class="mrd_footer_left">
                                    <span class="mrd_footer_label">Interactive drill-down enabled</span>
                                </div>
                                <span class="mrd_view_details">Open analytics</span>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

        <record id="view_material_requisition_dashboard_search" model="ir.ui.view">
        <field name="name">material.requisition.dashboard.search</field>
        <field name="model">material.requisition.dashboard</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="create_uid"/>
          
                <filter string="Requisition By State" name="filter_by_state" domain="[('operation_type', '=', 'requisition_by_state')]"/>
                <filter string="Bar Chart" name="filter_by_bar" domain="[('chart_type', '=', 'bar')]"/>
                
                <group>
                 
                    <filter string="Operation Type" name="groupby_operation_type" context="{'group_by': 'operation_type'}"/>
                    <filter string="Chart Type" name="groupby_chart_type" context="{'group_by': 'chart_type'}"/>
                    <filter string="Created on" name="groupby_created_on" context="{'group_by': 'create_date'}"/>
               
                    </group>
                </search>
        </field>
    </record>
    <record id="action_material_requisition_graph" model="ir.actions.act_window">
        <field name="name">Material Requisitions</field>
        <field name="res_model">material.requisition</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>


    <record id="click_dashboard_graph" model="ir.actions.server">
        <field name="name">material_requisition_and_approval.click_dashboard_graph</field>
        <field name="model_id" ref="material_requisition_and_approval.model_material_requisition"/>
        <field name="state">code</field>
        <field name="code">action = model.get_action_click_graph()</field>
    </record>

    <record id="click_dashboard_graph_product" model="ir.actions.server">
        <field name="name">material_requisition_and_approval.click_dashboard_graph_product</field>
        <field name="model_id" ref="material_requisition_and_approval.model_material_requisition_line"/>
        <field name="state">code</field>
        <field name="code">action = model.get_action_click_graph()</field>
    </record>

    <record id="action_material_requisition_dashboard" model="ir.actions.act_window">
        <field name="name">Material Requisition Dashboard</field>
        <field name="res_model">material.requisition.dashboard</field>
        <field name="view_mode">kanban</field>
        <field name="context">{'search_default_filter_by_state': 1, 'search_default_filter_by_bar': 1}</field>
        <field name="domain">[]</field>
    </record>

    <record id="action_material_requisition_dashboard_client" model="ir.actions.client">
        <field name="name">Material Requisition Dashboard</field>
        <field name="tag">material_requisition_dashboard_screen</field>
    </record>

    <record id="action_material_requisition_dashboard_edit" model="ir.actions.act_window">
        <field name="name">Material Requisition Dashboard</field>
        <field name="res_model">material.requisition.dashboard</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_material_requisition_dashboard_graph" model="ir.actions.act_window">
        <field name="name">Dashboard Graph View</field>
        <field name="res_model">material.requisition.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="material_requisition_and_approval.view_material_requisition_dashboard_graph_form"/>
        <field name="target">current</field>
    </record>

</odoo>