<odoo>

    <record id="view_fulfillment_wizard_internal_transfer_form" model="ir.ui.view">
        <field name="name">material.requisition.fulfillment.wizard.form</field>
        <field name="model">material.requisition.fulfillment.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Internal Transfer">
                <div class="alert alert-info" role="alert">
                    <strong>Internal Transfer:</strong> Select products and source locations to create internal transfers.
                </div>
                <group>
                    <field name="action_type" readonly="1" string="Fulfillment Type"/>
                    <field name="requisition_id" invisible="1"/>
                </group>
                
                <group string="Products to Transfer" class="mt-3">
                    <field name="line_ids" nolabel="1" domain="[('requisition_id','=',requisition_id),('rfq_id','=',False),('picking_id','=',False),('state','!=','cancelled')]">
                        <list editable="bottom" create="false" edit="true" delete="false">
                            <field name="product_id" readonly="1" string="Product"/>
                            <field name="quantity" readonly="1" string="Requested Qty"/>
                            <field name="available_qty" readonly="1" string="Available Qty"/>
                            <field name="qty_remaining" string="Transfer Qty" 
                                   attrs="{'required': [('id', '!=', False)]}"/>
                            <field name="all_stock_location_ids" column_invisible="True"/>
                            <field name="stock_location_id" 
                                   domain="[('id','in',all_stock_location_ids)]" 
                                   required="True" 
                                   string="Source Location"/>
                        </list>
                    </field>
                </group>
                
                <footer>
                    <button string="Create Transfer" type="object" name="action_fulfill" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>



<record id="view_fulfillment_wizard_purchase_order_form" model="ir.ui.view">
        <field name="name">material.requisition.fulfillment.wizard.purchase.form</field>
        <field name="model">material.requisition.fulfillment.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Purchase Orders">
                <div class="alert alert-info" role="alert">
                    <strong>Purchase Orders:</strong> Select products and vendors to create RFQs/Purchase Orders.
                </div>
                <group>
                    <field name="action_type" readonly="1" string="Fulfillment Type"/>
                    <field name="requisition_id" invisible="1"/>
                </group>
                
                <group string="Products to Purchase" class="mt-3">
                    <field name="line_ids" nolabel="1" domain="[('requisition_id','=',requisition_id),('rfq_id','=',False), ('picking_id','=',False),('state','!=','cancelled')]">
                        <list editable="bottom" create="false" edit="true" delete="false">
                            <field name="product_id" readonly="1" string="Product"/>
                            <field name="quantity" readonly="1" string="Requested Qty"/>
                            <field name="qty_remaining" string="Purchase Qty" 
                                   attrs="{'required': [('id', '!=', False)]}"/>
                            <field name="vendor_id" 
                                   domain="[('id','in',all_vendor_ids)]" 
                                   required="True" 
                                   string="Vendor"/>
                            <field name="all_vendor_ids" column_invisible="True"/>
                        </list>
                    </field>
                </group>

                <footer>
                    <button string="Create Purchase Orders" type="object" name="action_fulfill" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>


</odoo>