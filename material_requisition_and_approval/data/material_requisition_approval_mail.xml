<odoo>
   <record id="email_template_material_requisition_approval" model="mail.template">
    <field name="name">Material Requisition Approval</field>
    <field name="model_id" ref="model_material_requisition_approval"/>
    <field name="subject">Approval Required: {{object.requisition_id.name}}</field>
    <field name="email_from">{{ object.env.user.company_id.email_formatted }}</field>
    <field name="email_to">{{object.approver_ids and ','.join([a.email for a in object.approver_ids if a.email])}}</field>
    <field name="body_html" type="html">
       
            <p>Hello,</p>
            <p>A material requisition <b><t t-out='object.requisition_id.name' /></b> requires your approval.</p>
            <p>Requested by: <t t-out='object.requisition_id.employee_id.name' /></p>
            <p>Purpose: <t t-out='object.requisition_id.purpose' /></p>
            <p>Please review the request.</p>
            <br/>
            <p>Thanks,</p>
    </field>
</record>

</odoo>
