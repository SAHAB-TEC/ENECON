<odoo>
    <data>
        <record id="email_template_material_requisition_rejection" model="mail.template">
            <field name="name">Material Requisition Rejection</field>
            <field name="model_id" ref="material_requisition_and_approval.model_material_requisition"/>
            <field name="subject">Material Requisition Rejected - {{ object.name }}</field>
            <field name="email_from">{{ object.env.user.company_id.email_formatted }}</field>
            <field name="email_to">{{ object.requester_id.email }}</field>
            <field name="body_html" type="html">
<div style="margin:0; padding:20px; font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size:14px; color:#333; background-color:#f9f9f9;">
    <div style="max-width:600px; margin:auto; background:#ffffff; padding:30px;">
        
        <p style="font-size:16px;">Dear <t t-out="object.requester_id.name" />,</p>

        <p>Your material requisition <strong><t t-out="object.name" /></strong> has been 
            <span style="color:red; font-weight:bold;">rejected</span>.
        </p>

        <hr style="border:none; border-top:1px solid #ddd; margin:20px 0;" />

        <h3 style="font-size:16px; margin-bottom:10px;">Requisition Details</h3>
        <table style="width:100%; font-size:14px; border-collapse:separate;">
            <tr>
                <td style="padding:6px 0;"><strong>Request Date:</strong></td>
                <td style="padding:6px 0;"><t t-out="object.requested_date" /></td>
            </tr>
            <tr>
                <td style="padding:6px 0;"><strong>Department:</strong></td>
                <td style="padding:6px 0;"><t t-out="object.department_id.name" /></td>
            </tr>
            <tr>
                <td style="padding:6px 0;"><strong>Rejected By:</strong></td>
                <td style="padding:6px 0;">
                    <t t-out="(object.approval_ids.filtered(lambda a: a.status == 'rejected') and object.approval_ids.filtered(lambda a: a.status == 'rejected')[0].approved_by_id.name) or 'N/A'" />
                </td>
            </tr>
            <tr>
                <td style="padding:6px 0;"><strong>Rejection Date:</strong></td>
                <td style="padding:6px 0;">
                    <t t-out="(object.approval_ids.filtered(lambda a: a.status == 'rejected') and object.approval_ids.filtered(lambda a: a.status == 'rejected')[0].date) or 'N/A'" />
                </td>
            </tr>
        </table>

        <t t-if="object.approval_ids.filtered(lambda a: a.status == 'rejected' and a.remarks)">
            <h3 style="font-size:16px; margin-top:20px;">Rejection Reason</h3>
            <p style="color:#a94442; background:#f5f5f5; padding:10px; border-left:4px solid #d9534f;">
                <t t-out="object.approval_ids.filtered(lambda a: a.status == 'rejected')[0].remarks" />
            </p>
        </t>

        <p style="margin-top:20px;">Please review the reason provided and, if necessary, submit a revised requisition for further consideration.</p>

        <p style="margin-top:30px;">Best regards,<br/>
            <strong><t t-out="object.env.user.name" /></strong><br/>
            <t t-out="object.env.user.company_id.name" />
        </p>
    </div>
</div>
        
            </field>
        </record>
    </data>
</odoo>
