<odoo>

   
    <template id="report_material_summary_csv">
        <t t-foreach="docs" t-as="doc">
            Requisition,Requester,Department,Date
            <t t-esc="doc.name"/>,<t t-esc="doc.employee_id.name or ''"/>,<t t-esc="doc.department_id.name or ''"/>,<t t-esc="doc.required_date"/>

            Product,Quantity,UOM
            <t t-foreach="doc.requested_product_ids" t-as="line">
            <t t-esc="line.product_id.name"/>,<t t-esc="line.quantity"/>,<t t-esc="line.product_id.uom_id.name"/>
            </t>
        </t>
    </template>
</odoo>
