    <odoo>

        <template id="report_dispatch_log">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="material_requisition_and_approval.report_dispatch_log_detail" t-lang="user_id.lang"/>
                </t>
            </t>
        </template>


        <template id="report_dispatch_log_detail">
            <t t-call="web.basic_layout">
                <div class="page">
                    <h2>Dispatch Log</h2>

                    <p><strong>Requisition:</strong> <t t-esc="doc.name"/></p>
                    <p><strong>Requested by:</strong> <t t-esc="doc.employee_id.name"/></p>
                    <p><strong>Department:</strong> <t t-esc="doc.department_id.name"/></p>
                    <p><strong>Date:</strong> <t t-esc="doc.required_date"/></p>

                    <h4>Dispatched Pickings</h4>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Picking</th>
                                <th>Source</th>
                                <th>Destination</th>
                                <th>Product</th>
                                <th>Qty</th>
                                <th>Status</th>
                                <th>Type</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="pickings" t-value="doc.final_dispatch_ids"/>
                            <t t-foreach="pickings" t-as="picking">
                                <t t-foreach="picking.move_ids_without_package" t-as="move">
                                    <tr>
                                        <td><t t-esc="picking.name"/></td>
                                        <td><t t-esc="picking.location_id.display_name"/></td>
                                        <td><t t-esc="picking.location_dest_id.display_name"/></td>
                                        <td><t t-esc="move.product_id.name"/></td>
                                        <td><t t-esc="move.product_uom_qty"/></td>
                                        <td><t t-esc="picking.state"/></td>
                                        <td><t t-esc="picking.picking_type_id.name"/></td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </template>
    </odoo>