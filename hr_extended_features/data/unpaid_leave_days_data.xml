<odoo>
    <data noupdate="0">

        <record id="hr_salary_rule_unpaid_leave" model="hr.salary.rule">
            <field name="name">Unpaid Leave Deduction</field>
            <field name="code">UNPAID_LEAVE</field>
            <field name="sequence">105</field>
              <field name="category_id" ref="hr_payroll.DED"/>
            <field name="struct_id"
                   ref="rm_hr_attendance_sheet.structure_attendance_sheet"/>
            <field name="amount_select">code</field>

            <field name="amount_python_compute">
                <![CDATA[result = - (contract.wage / 30.0) * payslip.unpaid_leave_days]]>
            </field>
            <field name="appears_on_payslip" eval="True"/>
        </record>
    </data>
</odoo>
