<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Parent category: groups everything under one "Accommodation"
             section header on the res.users form's Access Rights tab. -->
        <record id="module_category_accommodation" model="ir.module.category">
            <field name="name">Accommodation</field>
            <field name="description">Access rights for the Accommodation module</field>
            <field name="sequence">25</field>
        </record>

        <!-- One child category per checkbox. Each child category holds a
             single group, which is precisely what makes Odoo render it as
             an independent checkbox instead of collapsing several groups
             into one radio-selection (which happens when groups within the
             same category form an implied_ids hierarchy). -->
        <record id="module_category_accommodation_module_access" model="ir.module.category">
            <field name="name">Module Access</field>
            <field name="parent_id" ref="module_category_accommodation"/>
            <field name="sequence">1</field>
        </record>
        <record id="module_category_accommodation_config_access" model="ir.module.category">
            <field name="name">Configuration Access</field>
            <field name="parent_id" ref="module_category_accommodation"/>
            <field name="sequence">2</field>
        </record>
        <record id="module_category_accommodation_create_guest" model="ir.module.category">
            <field name="name">Create Guest</field>
            <field name="parent_id" ref="module_category_accommodation"/>
            <field name="sequence">3</field>
        </record>
        <record id="module_category_accommodation_edit_guest" model="ir.module.category">
            <field name="name">Edit Guest</field>
            <field name="parent_id" ref="module_category_accommodation"/>
            <field name="sequence">4</field>
        </record>
        <record id="module_category_accommodation_create_repair" model="ir.module.category">
            <field name="name">Create Maintenance Request</field>
            <field name="parent_id" ref="module_category_accommodation"/>
            <field name="sequence">5</field>
        </record>
        <record id="module_category_accommodation_edit_repair" model="ir.module.category">
            <field name="name">Edit Maintenance Request</field>
            <field name="parent_id" ref="module_category_accommodation"/>
            <field name="sequence">6</field>
        </record>
        <record id="module_category_accommodation_approve_repair" model="ir.module.category">
            <field name="name">Approve Maintenance (Done)</field>
            <field name="parent_id" ref="module_category_accommodation"/>
            <field name="sequence">7</field>
        </record>

        <!-- The 7 groups. Intentionally NOT chained via implied_ids to each
             other (beyond what's noted below) so every checkbox stays
             independently toggleable, matching "Create Guest" and
             "Edit Guest" etc. being separate switches in the spec. -->
        <record id="group_accommodation_user" model="res.groups">
            <field name="name">Accommodation Module Access</field>
            <field name="category_id" ref="module_category_accommodation_module_access"/>
            <field name="comment">Toggles visibility of the Accommodation app icon on the main dashboard. Required for any other Accommodation checkbox to have an effect.</field>
        </record>

        <record id="group_accommodation_config" model="res.groups">
            <field name="name">Configuration Menu Access</field>
            <field name="category_id" ref="module_category_accommodation_config_access"/>
            <field name="comment">Toggles visibility of the Configuration menu (Accommodation Types) and grants full manage rights on it.</field>
        </record>

        <record id="group_create_guest" model="res.groups">
            <field name="name">Create Guest</field>
            <field name="category_id" ref="module_category_accommodation_create_guest"/>
            <field name="comment">Controls visibility of the "Add New Guest" button.</field>
        </record>

        <record id="group_edit_guest" model="res.groups">
            <field name="name">Edit Guest</field>
            <field name="category_id" ref="module_category_accommodation_edit_guest"/>
            <field name="comment">Allows modifying guest profile data after creation. Without it, guest records are read-only.</field>
        </record>

        <record id="group_create_repair" model="res.groups">
            <field name="name">Create Maintenance Request</field>
            <field name="category_id" ref="module_category_accommodation_create_repair"/>
            <field name="comment">Controls visibility of the "Create Maintenance Request" button.</field>
        </record>

        <record id="group_edit_repair" model="res.groups">
            <field name="name">Edit Maintenance Request</field>
            <field name="category_id" ref="module_category_accommodation_edit_repair"/>
            <field name="comment">Allows modification of saved maintenance requests. Without it, requests are read-only.</field>
        </record>

        <record id="group_approve_repair" model="res.groups">
            <field name="name">Approve Maintenance (Done)</field>
            <field name="category_id" ref="module_category_accommodation_approve_repair"/>
            <field name="comment">Shows the "Maintenance Completed" button and is required (checked server-side) to close a maintenance request.</field>
        </record>
    </data>
</odoo>
