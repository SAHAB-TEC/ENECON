<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_accommodation_repair_list" model="ir.ui.view">
        <field name="name">accommodation.repair.list</field>
        <field name="model">accommodation.repair</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="item_id"/>
                <field name="request_date"/>
                <field name="location"/>
                <field name="project_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_accommodation_repair_form" model="ir.ui.view">
        <field name="name">accommodation.repair.form</field>
        <field name="model">accommodation.repair</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_progress" type="object" string="Start Progress"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mark_completed" type="object" string="Maintenance Completed"
                            class="btn-primary" groups="accommodation.group_approve_repair"
                            invisible="state == 'done'"/>
                    <button name="action_reset_draft" type="object" string="Reset to New"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="unit_id"/>
                            <field name="item_id"/>
                            <field name="faulty_party_id"/>
                        </group>
                        <group>
                            <field name="request_date"/>
                            <field name="location"/>
                            <field name="project_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                        <field name="notes"/>
                    </group>
                    <group string="Completion" invisible="state != 'done'">
                        <field name="completed_by" readonly="1"/>
                        <field name="completed_date" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_accommodation_repair_search" model="ir.ui.view">
        <field name="name">accommodation.repair.search</field>
        <field name="model">accommodation.repair</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="project_id"/>
                <field name="location"/>
                <filter string="New" name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="In Progress" name="filter_in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="Completed" name="filter_done" domain="[('state','=','done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Housing Unit" name="group_unit" context="{'group_by': 'unit_id'}"/>
                    <filter string="Location" name="group_location" context="{'group_by': 'location'}"/>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_accommodation_repair_pivot" model="ir.ui.view">
        <field name="name">accommodation.repair.pivot</field>
        <field name="model">accommodation.repair</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="location" type="row"/>
                <field name="project_id" type="row"/>
                <field name="unit_id" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_accommodation_repair_graph" model="ir.ui.view">
        <field name="name">accommodation.repair.graph</field>
        <field name="model">accommodation.repair</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="location" type="row"/>
                <field name="state" type="row"/>
            </graph>
        </field>
    </record>

    <record id="action_accommodation_repair" model="ir.actions.act_window">
        <field name="name">Maintenance</field>
        <field name="res_model">accommodation.repair</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_accommodation_repair_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Create your first maintenance request
            </p>
        </field>
    </record>

    <record id="action_accommodation_repair_report" model="ir.actions.act_window">
        <field name="name">Maintenance Analytics</field>
        <field name="res_model">accommodation.repair</field>
        <field name="view_mode">pivot,graph</field>
        <field name="search_view_id" ref="view_accommodation_repair_search"/>
    </record>
</odoo>
