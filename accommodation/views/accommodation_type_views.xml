<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_accommodation_type_list" model="ir.ui.view">
        <field name="name">accommodation.type.list</field>
        <field name="model">accommodation.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" placeholder="e.g. Apartment, Trailer, Studio"/>
            </list>
        </field>
    </record>

    <record id="action_accommodation_type" model="ir.actions.act_window">
        <field name="name">Accommodation Types</field>
        <field name="res_model">accommodation.type</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Add your first accommodation type
            </p>
        </field>
    </record>
</odoo>
