<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payroll_bank_report_wizard_form" model="ir.ui.view">
        <field name="name">payroll.bank.report.wizard.form</field>
        <field name="model">payroll.bank.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Payroll Bank Report">
                <group>
                    <group string="Period">
                        <field name="month"/>
                        <field name="year"/>
                        <field name="date_from" readonly="1"/>
                        <field name="date_to" readonly="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Filters">
                        <field name="filter_by" widget="radio"/>
                        <field name="employee_ids" widget="many2many_tags" invisible="filter_by != 'employees'" required="filter_by == 'employees'"/>
                        <field name="department_ids" widget="many2many_tags" invisible="filter_by != 'departments'" required="filter_by == 'departments'"/>
                        <field name="bank_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_view_lines" string="View" type="object" class="btn-secondary"/>
                    <button name="action_print_pdf" string="Print PDF" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_payroll_bank_report_wizard" model="ir.actions.act_window">
        <field name="name">Payroll Bank Report</field>
        <field name="res_model">payroll.bank.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_payroll_bank_report_root"
              name="Payroll Bank Report"
              sequence="90"/>

    <menuitem id="menu_payroll_bank_report"
              name="Print Report"
              parent="menu_payroll_bank_report_root"
              action="action_payroll_bank_report_wizard"
              sequence="10"/>
</odoo>
