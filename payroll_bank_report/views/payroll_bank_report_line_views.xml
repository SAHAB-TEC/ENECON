<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payroll_bank_report_line_list" model="ir.ui.view">
        <field name="name">payroll.bank.report.line.list</field>
        <field name="model">payroll.bank.report.line</field>
        <field name="arch" type="xml">
            <list string="Payroll Bank Report" create="0" edit="0" delete="1">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="net_salary" sum="Total Net Salary"/>
                <field name="account_number"/>
                <field name="bank_id"/>
                <field name="payslip_count"/>
            </list>
        </field>
    </record>

    <record id="view_payroll_bank_report_line_search" model="ir.ui.view">
        <field name="name">payroll.bank.report.line.search</field>
        <field name="model">payroll.bank.report.line</field>
        <field name="arch" type="xml">
            <search string="Payroll Bank Report">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="bank_id"/>
                <field name="account_number"/>

                <filter name="has_bank" string="Has Bank" domain="[('bank_id', '!=', False)]"/>
                <filter name="missing_bank" string="Missing Bank" domain="[('bank_id', '=', False)]"/>
                <filter name="missing_account" string="Missing Account Number" domain="[('account_number', '=', False)]"/>

                <separator/>

                <filter name="group_by_department" string="Department" context="{'group_by': 'department_id'}"/>
                <filter name="group_by_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_by_bank" string="Bank" context="{'group_by': 'bank_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_payroll_bank_report_line_pivot" model="ir.ui.view">
        <field name="name">payroll.bank.report.line.pivot</field>
        <field name="model">payroll.bank.report.line</field>
        <field name="arch" type="xml">
            <pivot string="Payroll Bank Report">
                <field name="department_id" type="row"/>
                <field name="employee_id" type="row"/>
                <field name="net_salary" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_payroll_bank_report_line_graph" model="ir.ui.view">
        <field name="name">payroll.bank.report.line.graph</field>
        <field name="model">payroll.bank.report.line</field>
        <field name="arch" type="xml">
            <graph string="Payroll Bank Report" type="bar">
                <field name="department_id"/>
                <field name="net_salary" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_payroll_bank_report_line" model="ir.actions.act_window">
        <field name="name">Payroll Bank Report Lines</field>
        <field name="res_model">payroll.bank.report.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_payroll_bank_report_line_search"/>
    </record>
</odoo>
