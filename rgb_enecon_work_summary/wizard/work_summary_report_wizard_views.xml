<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rgb_enecon_work_summary_report_wizard_form" model="ir.ui.view">
        <field name="name">rgb.enecon.work.summary.report.wizard.form</field>
        <field name="model">rgb.enecon.work.summary.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Work Summary">
                <group>
                    <field name="project_id"
                        options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="approved_only"/>
                </group>
                <footer>
                    <button name="action_print_report" string="Print PDF"
                        type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rgb_enecon_work_summary_report_wizard"
        model="ir.actions.act_window">
        <field name="name">Print Work Summary</field>
        <field name="res_model">rgb.enecon.work.summary.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_rgb_enecon_work_summary_report"
        name="Print Work Summary"
        parent="sdlc_construction_management.menu_construction_executions"
        action="action_rgb_enecon_work_summary_report_wizard" sequence="26"
        groups="sdlc_construction_management.group_construction_user"/>
</odoo>
