<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rgb_enecon_work_summary_entry_list" model="ir.ui.view">
        <field name="name">rgb.enecon.work.summary.entry.list</field>
        <field name="model">rgb.enecon.work.summary.entry</field>
        <field name="arch" type="xml">
            <list string="Work Summary Daily Entries"
                  decoration-success="state == 'approved'"
                  decoration-muted="state == 'new'">
                <field name="name"/>
                <field name="date"/>
                <field name="project_id"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_rgb_enecon_work_summary_entry_form" model="ir.ui.view">
        <field name="name">rgb.enecon.work.summary.entry.form</field>
        <field name="model">rgb.enecon.work.summary.entry</field>
        <field name="arch" type="xml">
            <form string="Work Summary Daily Entry">
                <header>
                    <button name="action_approve" string="Approve" type="object"
                        class="btn-primary"
                        groups="rgb_enecon_work_summary.group_rgb_enecon_work_summary_approver"
                        invisible="state != 'new'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,approved"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Approved" invisible="state != 'approved'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" readonly="state == 'approved'"
                                options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="date" readonly="state == 'approved'"/>
                            <field name="company_id" readonly="1"
                                groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Materials">
                            <field name="material_line_ids" readonly="state == 'approved'">
                                <list editable="bottom">
                                    <field name="product_id"
                                        options="{'no_create': True, 'no_create_edit': True}"
                                        domain="[('rgb_enecon_material', '=', True)]"/>
                                    <field name="quantity"/>
                                    <field name="uom_category_id" column_invisible="True"/>
                                    <field name="uom_id"
                                        options="{'no_create': True, 'no_create_edit': True}"
                                        domain="[('category_id', '=', uom_category_id)]"/>
                                </list>
                            </field>
                        </page>
                        <page string="Workforce">
                            <field name="workforce_line_ids" readonly="state == 'approved'">
                                <list editable="bottom">
                                    <field name="job_id"
                                        options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Transportation / Equipment">
                            <group>
                                <field name="notes_before_transport"
                                    readonly="state == 'approved'"/>
                            </group>
                            <field name="transport_line_ids" readonly="state == 'approved'">
                                <list editable="bottom">
                                    <field name="transport_type_id"
                                        options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                            <group>
                                <field name="notes_after_transport"
                                    readonly="state == 'approved'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rgb_enecon_work_summary_entry_search" model="ir.ui.view">
        <field name="name">rgb.enecon.work.summary.entry.search</field>
        <field name="model">rgb.enecon.work.summary.entry</field>
        <field name="arch" type="xml">
            <search string="Work Summary Entries">
                <field name="name"/>
                <field name="project_id"/>
                <field name="date"/>
                <filter name="filter_new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="filter_approved" string="Approved"
                    domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter name="group_project" string="Project"
                    context="{'group_by': 'project_id'}"/>
                <filter name="group_date" string="Date"
                    context="{'group_by': 'date'}"/>
                <filter name="group_state" string="Status"
                    context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_rgb_enecon_work_summary_entry" model="ir.actions.act_window">
        <field name="name">Work Summary Entries</field>
        <field name="res_model">rgb.enecon.work.summary.entry</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rgb_enecon_work_summary_entry_search"/>
    </record>

    <menuitem id="menu_rgb_enecon_work_summary_entry"
        name="Work Summary"
        parent="sdlc_construction_management.menu_construction_executions"
        action="action_rgb_enecon_work_summary_entry" sequence="25"
        groups="sdlc_construction_management.group_construction_user"/>
</odoo>
