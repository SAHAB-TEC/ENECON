<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_rgb_enecon_work_summary" model="ir.actions.report">
        <field name="name">Work Summary</field>
        <field name="model">rgb.enecon.work.summary.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rgb_enecon_work_summary.report_rgb_enecon_work_summary_document</field>
        <field name="report_file">rgb_enecon_work_summary.report_rgb_enecon_work_summary_document</field>
        <field name="print_report_name">'Work Summary - %s' % (object.project_id.name)</field>
    </record>

    <template id="report_rgb_enecon_work_summary_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">
                        <span>ملخص </span><span t-field="project.name"/>
                    </h2>
                    <p class="text-center">
                        <strong>Period:</strong>
                        <span t-field="docs.date_from"/> - <span t-field="docs.date_to"/>
                    </p>

                    <h4>Materials</h4>
                    <t t-if="material_columns">
                        <table class="table table-sm table-bordered" style="font-size:10px;">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th t-foreach="material_columns" t-as="column"
                                        class="text-center">
                                        <div t-esc="column['name']"/>
                                        <small t-esc="column['uom']"/>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="material_rows" t-as="row">
                                    <td><span t-esc="row['date']"/></td>
                                    <td t-foreach="row['values']" t-as="value"
                                        class="text-end"><span t-esc="value"/></td>
                                </tr>
                                <tr class="fw-bold">
                                    <td>Total</td>
                                    <td t-foreach="material_totals" t-as="value"
                                        class="text-end"><span t-esc="value"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                    <p t-else="" class="text-muted">
                        No material data for the selected period.
                    </p>

                    <h4 class="mt-4">Workforce</h4>
                    <t t-if="workforce_columns">
                        <table class="table table-sm table-bordered" style="font-size:10px;">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th t-foreach="workforce_columns" t-as="column"
                                        class="text-center">
                                        <span t-esc="column['name']"/>
                                    </th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="workforce_rows" t-as="row">
                                    <td><span t-esc="row['date']"/></td>
                                    <td t-foreach="row['values']" t-as="value"
                                        class="text-end"><span t-esc="value"/></td>
                                    <td class="text-end"><span t-esc="row['total']"/></td>
                                </tr>
                                <tr class="fw-bold">
                                    <td>Total</td>
                                    <td t-foreach="workforce_totals" t-as="value"
                                        class="text-end"><span t-esc="value"/></td>
                                    <td class="text-end">
                                        <span t-esc="workforce_grand_total"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                    <p t-else="" class="text-muted">
                        No workforce data for the selected period.
                    </p>

                    <h4 class="mt-4">Transportation / Equipment</h4>
                    <t t-if="transport_columns">
                        <table class="table table-sm table-bordered" style="font-size:10px;">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th t-foreach="transport_columns" t-as="column"
                                        class="text-center">
                                        <span t-esc="column['name']"/>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="transport_rows" t-as="row">
                                    <td><span t-esc="row['date']"/></td>
                                    <td t-foreach="row['values']" t-as="value"
                                        class="text-end"><span t-esc="value"/></td>
                                </tr>
                                <tr class="fw-bold">
                                    <td>Total</td>
                                    <td t-foreach="transport_totals" t-as="value"
                                        class="text-end"><span t-esc="value"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                    <p t-else="" class="text-muted">
                        No transportation / equipment data for the selected period.
                    </p>

                    <t t-if="notes">
                        <h4 class="mt-4">Notes</h4>
                        <table class="table table-sm table-bordered" style="font-size:10px;">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Before Transportation / Equipment</th>
                                    <th>After Transportation / Equipment</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="notes" t-as="note">
                                    <td><span t-esc="note['date']"/></td>
                                    <td style="white-space:pre-wrap;">
                                        <span t-esc="note['before']"/>
                                    </td>
                                    <td style="white-space:pre-wrap;">
                                        <span t-esc="note['after']"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
