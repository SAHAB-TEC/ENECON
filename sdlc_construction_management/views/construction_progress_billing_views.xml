<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_construction_progress_billing_list" model="ir.ui.view">
        <field name="name">construction.progress.billing.list</field>
        <field name="model">construction.progress.billing</field>
        <field name="arch" type="xml">
            <list string="Progress Billing">
                <field name="reference"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="sub_project_id"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="total_amount" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'in_progress'"
                       decoration-success="state == 'completed'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_construction_progress_billing_form" model="ir.ui.view">
        <field name="name">construction.progress.billing.form</field>
        <field name="model">construction.progress.billing</field>
        <field name="arch" type="xml">
            <form string="Progress Billing">
                <header>
                    <button name="action_start" string="Start" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_create_invoice" string="Create Invoice" type="object"
                            class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_complete" string="Complete" type="object"
                            invisible="state != 'in_progress'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="sub_project_id"/>
                            <field name="date"/>
                        </group>
                        <group string="Customer Details">
                            <field name="partner_id"/>
                            <field name="invoice_type" widget="radio"/>
                        </group>
                    </group>
                    <group string="Phase &amp; Work Order">
                        <group>
                            <field name="phase_id"/>
                            <field name="work_order_id"/>
                        </group>
                        <group string="Include Work Order Lines">
                            <field name="include_material"/>
                            <field name="include_equipment"/>
                            <field name="include_labour"/>
                            <field name="include_overhead"/>
                        </group>
                    </group>
                    <button name="action_load_work_order_lines" string="Load Work Order Lines" type="object"
                            class="btn-secondary" icon="fa-download"
                            invisible="state != 'draft'"/>
                    <notebook>
                        <page string="Materials">
                            <field name="material_line_ids" context="{'default_line_type': 'material'}">
                                <list editable="bottom">
                                    <field name="line_type" column_invisible="1"/>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="unit_price"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="tax_amount"/>
                                    <field name="total_amount" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="material_total"/>
                            </group>
                        </page>
                        <page string="Equipment">
                            <field name="equipment_line_ids" context="{'default_line_type': 'equipment'}">
                                <list editable="bottom">
                                    <field name="line_type" column_invisible="1"/>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="unit_price"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="tax_amount"/>
                                    <field name="total_amount" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="equipment_total"/>
                            </group>
                        </page>
                        <page string="Labour">
                            <field name="labour_line_ids" context="{'default_line_type': 'labour'}">
                                <list editable="bottom">
                                    <field name="line_type" column_invisible="1"/>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="unit_price"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="tax_amount"/>
                                    <field name="total_amount" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="labour_total"/>
                            </group>
                        </page>
                        <page string="Overhead">
                            <field name="overhead_line_ids" context="{'default_line_type': 'overhead'}">
                                <list editable="bottom">
                                    <field name="line_type" column_invisible="1"/>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="unit_price"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="tax_amount"/>
                                    <field name="total_amount" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="overhead_total"/>
                            </group>
                        </page>
                        <page string="Others">
                            <field name="other_line_ids" context="{'default_line_type': 'other'}">
                                <list editable="bottom">
                                    <field name="line_type" column_invisible="1"/>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="unit_price"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="tax_amount"/>
                                    <field name="total_amount" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="other_total"/>
                            </group>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="material_total" string="Material Total"/>
                        <field name="equipment_total" string="Equipment Total"/>
                        <field name="labour_total" string="Labour Total"/>
                        <field name="overhead_total" string="Overhead Total"/>
                        <field name="other_total" string="Other Total"/>
                        <field name="total_amount" class="oe_subtotal_footer_separator"/>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_construction_progress_billing_search" model="ir.ui.view">
        <field name="name">construction.progress.billing.search</field>
        <field name="model">construction.progress.billing</field>
        <field name="arch" type="xml">
            <search string="Progress Billing">
                <field name="name"/>
                <field name="reference"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_construction_progress_billing" model="ir.actions.act_window">
        <field name="name">Progress Billing</field>
        <field name="res_model">construction.progress.billing</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Progress Billing
            </p>
        </field>
    </record>
</odoo>
