<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_construction_material_requisition_list" model="ir.ui.view">
        <field name="name">construction.material.requisition.list</field>
        <field name="model">construction.material.requisition</field>
        <field name="arch" type="xml">
            <list string="Material Requisitions" decoration-info="state == 'draft'"
                  decoration-warning="state == 'under_approval'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="sub_project_id"/>
                <field name="date"/>
                <field name="requested_by"/>
                <field name="department_id"/>
                <field name="total_amount" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'under_approval'"
                       decoration-success="state in ('approved', 'done')"
                       decoration-danger="state in ('rejected', 'cancelled')"
                       decoration-primary="state == 'in_progress'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_construction_material_requisition_form" model="ir.ui.view">
        <field name="name">construction.material.requisition.form</field>
        <field name="model">construction.material.requisition</field>
        <field name="arch" type="xml">
            <form string="Material Requisition">
                <header>
                    <button name="action_submit_approval" string="Submit for Approval" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="oe_highlight" invisible="state != 'under_approval'"
                            groups="sdlc_construction_management.group_construction_manager"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'under_approval'"
                            groups="sdlc_construction_management.group_construction_manager"/>
                    <button name="action_create_purchase_order" string="Create Purchase Order" type="object"
                            class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_create_internal_transfer" string="Create Internal Transfer" type="object"
                            invisible="state != 'approved'"/>
                    <button name="action_ready" string="Ready for Delivery" type="object"
                            invisible="state != 'in_progress'"/>
                    <button name="action_withdrawal" string="Withdrawal" type="object"
                            invisible="state != 'ready'"/>
                    <button name="action_done" string="Done" type="object"
                            class="oe_highlight" invisible="state != 'withdrawal'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('rejected', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,under_approval,approved,in_progress,ready,withdrawal,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="purchase_order_count" widget="statinfo" string="Purchase Orders"/>
                        </button>
                        <button name="action_view_transfers" type="object" class="oe_stat_button" icon="fa-exchange">
                            <field name="internal_transfer_count" widget="statinfo" string="Transfers"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="sub_project_id"/>
                            <field name="work_order_id"/>
                            <field name="warehouse_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="required_date"/>
                            <field name="requested_by"/>
                            <field name="department_id"/>
                            <field name="approved_by" invisible="state not in ('approved', 'in_progress', 'ready', 'withdrawal', 'done')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Requisition Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="unit_price"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="vendor_id"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_amount" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                            <field name="rejection_reason" invisible="state != 'rejected'"
                                   placeholder="Rejection reason..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_construction_material_requisition_search" model="ir.ui.view">
        <field name="name">construction.material.requisition.search</field>
        <field name="model">construction.material.requisition</field>
        <field name="arch" type="xml">
            <search string="Material Requisitions">
                <field name="name"/>
                <field name="project_id"/>
                <field name="requested_by"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="under_approval" string="Under Approval" domain="[('state', '=', 'under_approval')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_construction_material_requisition" model="ir.actions.act_window">
        <field name="name">Material Requisitions</field>
        <field name="res_model">construction.material.requisition</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Material Requisition
            </p>
        </field>
    </record>
</odoo>
