<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quick Create Form -->
    <record id="view_construction_project_form_quick_create" model="ir.ui.view">
        <field name="name">construction.project.form.quick.create</field>
        <field name="model">construction.project</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" string="Project Name" placeholder="e.g. Tower A"/>
                </group>
            </form>
        </field>
    </record>

    <!-- Kanban View: click opens the project form directly -->
    <record id="view_construction_project_kanban" model="ir.ui.view">
        <field name="name">construction.project.kanban</field>
        <field name="model">construction.project</field>
        <field name="arch" type="xml">
            <kanban highlight_color="color"
                    class="o_kanban_mobile"
                    quick_create_view="sdlc_construction_management.view_construction_project_form_quick_create"
                    sample="1"
                    default_order="sequence, name, id"
                    default_group_by="state">
                <field name="name"/>
                <field name="reference"/>
                <field name="warehouse_id"/>
                <field name="city"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
                <field name="stage_id"/>
                <field name="sub_project_count"/>
                <field name="task_count"/>
                <field name="purchase_order_count"/>
                <field name="active"/>
                <field name="color"/>
                <field name="sequence" widget="handle"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-baseline gap-1">
                            <div class="min-w-0 flex-grow-1 pb-3">
                                <span class="text-truncate d-block fs-4 fw-bold">
                                    <field name="name"/>
                                </span>
                                <span class="text-muted d-block" t-if="record.reference.value">
                                    <field name="reference"/>
                                </span>
                                <span class="text-muted d-block" t-if="record.warehouse_id.value">
                                    <span class="fa fa-building me-1" title="Warehouse"/>
                                    <field name="warehouse_id"/>
                                </span>
                                <span class="text-muted d-block" t-if="record.city.value">
                                    <span class="fa fa-map-marker me-1" title="City"/>
                                    <field name="city"/>
                                </span>
                                <div t-if="record.date_start.raw_value or record.date_end.raw_value" class="text-muted">
                                    <span class="fa fa-clock-o me-1" title="Dates"/>
                                    <field name="date_start"/>
                                    <i t-if="record.date_start.raw_value and record.date_end.raw_value"
                                       class="fa fa-long-arrow-right mx-1" aria-label="Arrow" title="Arrow"/>
                                    <field name="date_end"/>
                                </div>
                            </div>
                        </div>
                        <footer class="mt-auto pt-0">
                            <div class="d-flex align-items-center">
                                <div class="d-flex gap-2">
                                    <a class="btn btn-link p-0 text-dark" name="action_view_sub_projects" type="object" t-if="record.sub_project_count.raw_value">
                                        <span class="fa fa-sitemap me-1"/>
                                        <field name="sub_project_count"/>
                                    </a>
                                    <a class="btn btn-link p-0 text-dark" name="action_view_tasks" type="object" t-if="record.task_count.raw_value">
                                        <span class="fa fa-check-square-o me-1"/>
                                        <field name="task_count"/>
                                    </a>
                                    <a class="btn btn-link p-0 text-dark" name="action_view_purchase_orders" type="object" t-if="record.purchase_order_count.raw_value">
                                        <span class="fa fa-shopping-cart me-1"/>
                                        <field name="purchase_order_count"/>
                                    </a>
                                </div>
                                <field name="activity_ids" widget="kanban_activity" class="ms-auto"/>
                            </div>
                            <field name="state" widget="badge" class="mt-1"
                                   decoration-success="state == 'ongoing'"
                                   decoration-warning="state in ('stopped', 'suspended')"
                                   decoration-danger="state == 'closed'"
                                   decoration-info="state == 'completed'"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Kanban grouped by state (kept for action binding compatibility) -->
    <record id="view_construction_project_kanban_group_stage" model="ir.ui.view">
        <field name="name">construction.project.kanban.group.state</field>
        <field name="model">construction.project</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="view_construction_project_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="default_group_by">state</attribute>
            </xpath>
        </field>
    </record>

    <!-- List View -->
    <record id="view_construction_project_list" model="ir.ui.view">
        <field name="name">construction.project.list</field>
        <field name="model">construction.project</field>
        <field name="arch" type="xml">
            <list string="Projects" default_group_by="state"
                  decoration-success="state == 'ongoing'"
                  decoration-warning="state in ('stopped', 'suspended')"
                  decoration-muted="state == 'closed'"
                  decoration-info="state == 'completed'">
                <field name="sequence" widget="handle"/>
                <field name="reference"/>
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'ongoing'"
                       decoration-warning="state in ('stopped', 'suspended')"
                       decoration-danger="state == 'closed'"
                       decoration-info="state == 'completed'"/>
                <field name="stage_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_construction_project_form" model="ir.ui.view">
        <field name="name">construction.project.form</field>
        <field name="model">construction.project</field>
        <field name="arch" type="xml">
            <form string="Project">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="ongoing,stopped,suspended,closed,completed"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="جاري" bg_color="text-bg-success"
                            invisible="state != 'ongoing' or not active"/>
                    <widget name="web_ribbon" title="متوقف" bg_color="text-bg-warning"
                            invisible="state != 'stopped' or not active"/>
                    <widget name="web_ribbon" title="معلّق" bg_color="text-bg-warning"
                            invisible="state != 'suspended' or not active"/>
                    <widget name="web_ribbon" title="مغلق" bg_color="text-bg-danger"
                            invisible="state != 'closed' or not active"/>
                    <widget name="web_ribbon" title="مكتمل" bg_color="text-bg-info"
                            invisible="state != 'completed' or not active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="purchase_order_count" widget="statinfo" string="Purchases"/>
                        </button>
                        <button name="action_view_sub_projects" type="object" class="oe_stat_button" icon="fa-sitemap">
                            <field name="sub_project_count" widget="statinfo" string="Sub Projects"/>
                        </button>
                        <button name="action_view_budgets" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="budget_count" widget="statinfo" string="Budgets"/>
                        </button>
                        <button name="action_view_phases" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="phase_count" widget="statinfo" string="Phases"/>
                        </button>
                        <button name="action_view_work_orders" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="work_order_count" widget="statinfo" string="Work Orders"/>
                        </button>
                        <button name="action_view_mreq" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="mreq_count" widget="statinfo" string="MREQ"/>
                        </button>
                        <button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-check-square-o">
                            <field name="task_count" widget="statinfo" string="Tasks"/>
                        </button>
                        <button name="action_view_expenses" type="object" class="oe_stat_button" icon="fa-credit-card">
                            <field name="expense_count" widget="statinfo" string="Expenses"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="reference" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active" invisible="1"/>
                            <field name="warehouse_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="stage_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Address">
                            <group>
                                <group>
                                    <field name="street"/>
                                    <field name="street2"/>
                                    <field name="city"/>
                                    <field name="state_id"/>
                                </group>
                                <group>
                                    <field name="zip"/>
                                    <field name="country_id"/>
                                    <field name="longitude"/>
                                    <field name="latitude"/>
                                </group>
                            </group>
                        </page>
                        <page string="Contact">
                            <group>
                                <group>
                                    <field name="phone"/>
                                    <field name="mobile"/>
                                    <field name="email"/>
                                </group>
                            </group>
                        </page>
                        <page string="Sub Projects">
                            <field name="sub_project_ids">
                                <list>
                                    <field name="reference"/>
                                    <field name="name"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Images">
                            <field name="image_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="image" widget="image" options="{'size': [100, 100]}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Permits &amp; Approvals">
                            <field name="permit_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="permit_type"/>
                                    <field name="issue_date"/>
                                    <field name="expiry_date"/>
                                    <field name="issuing_authority"/>
                                    <field name="state" widget="badge"/>
                                    <field name="document"/>
                                    <field name="document_name" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_construction_project_search" model="ir.ui.view">
        <field name="name">construction.project.search</field>
        <field name="model">construction.project</field>
        <field name="arch" type="xml">
            <search string="Projects">
                <field name="name"/>
                <field name="reference"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="state"/>
                <separator/>
                <filter name="ongoing" string="جاري" domain="[('state', '=', 'ongoing')]"/>
                <filter name="stopped" string="متوقف" domain="[('state', '=', 'stopped')]"/>
                <filter name="suspended" string="معلّق" domain="[('state', '=', 'suspended')]"/>
                <filter name="closed" string="مغلق" domain="[('state', '=', 'closed')]"/>
                <filter name="completed" string="مكتمل" domain="[('state', '=', 'completed')]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_country" string="Country" context="{'group_by': 'country_id'}"/>
                    <filter name="group_warehouse" string="Warehouse" context="{'group_by': 'warehouse_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_construction_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">construction.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_construction_project_kanban"/>
        <field name="search_view_id" ref="view_construction_project_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Project
            </p>
            <p>
                Organize projects by status and track progress from start to completion.
            </p>
        </field>
    </record>

    <record id="action_construction_project_kanban_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_construction_project_kanban_group_stage"/>
        <field name="act_window_id" ref="action_construction_project"/>
    </record>

    <record id="action_construction_project_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_construction_project_list"/>
        <field name="act_window_id" ref="action_construction_project"/>
    </record>

    <!-- Purchase Order: link to construction project -->
    <record id="view_purchase_order_form_construction_project" model="ir.ui.view">
        <field name="name">purchase.order.form.construction.project</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="construction_project_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_tree_construction_project" model="ir.ui.view">
        <field name="name">purchase.order.list.construction.project</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="construction_project_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_kpis_tree_construction_project" model="ir.ui.view">
        <field name="name">purchase.order.kpis.list.construction.project</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="construction_project_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
