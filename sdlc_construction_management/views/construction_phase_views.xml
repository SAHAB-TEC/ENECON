<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_construction_phase_list" model="ir.ui.view">
        <field name="name">construction.phase.list</field>
        <field name="model">construction.phase</field>
        <field name="arch" type="xml">
            <list string="Phases (WBS)">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="title"/>
                <field name="project_id"/>
                <field name="sub_project_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="total_cost" sum="Total"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'in_progress'"
                       decoration-success="state == 'completed'"
                       decoration-warning="state == 'on_hold'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_construction_phase_form" model="ir.ui.view">
        <field name="name">construction.phase.form</field>
        <field name="model">construction.phase</field>
        <field name="arch" type="xml">
            <form string="Phase (WBS)">
                <header>
                    <button name="action_start" string="Start" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_complete" string="Complete" type="object"
                            class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_hold" string="On Hold" type="object"
                            invisible="state != 'in_progress'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state in ('draft', 'completed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_work_orders" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="work_order_count" widget="statinfo" string="Work Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="title"/>
                            <field name="project_id"/>
                            <field name="sub_project_id"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="sequence"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Costing">
                            <group>
                                <group>
                                    <field name="material_cost"/>
                                    <field name="equipment_cost"/>
                                </group>
                                <group>
                                    <field name="labour_cost"/>
                                    <field name="overhead_cost"/>
                                </group>
                            </group>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_cost" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Phase Entries">
                            <field name="entry_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="entry_type"/>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Child Phases">
                            <field name="child_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="title"/>
                                    <field name="total_cost" sum="Total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Work Orders">
                            <field name="work_order_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="total_amount" sum="Total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_construction_phase_search" model="ir.ui.view">
        <field name="name">construction.phase.search</field>
        <field name="model">construction.phase</field>
        <field name="arch" type="xml">
            <search string="Phases">
                <field name="name"/>
                <field name="title"/>
                <field name="project_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_sub_project" string="Sub Project" context="{'group_by': 'sub_project_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_construction_phase" model="ir.actions.act_window">
        <field name="name">Phases (WBS)</field>
        <field name="res_model">construction.phase</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Phase / WBS
            </p>
        </field>
    </record>
</odoo>
