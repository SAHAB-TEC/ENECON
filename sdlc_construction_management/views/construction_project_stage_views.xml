<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="construction_project_stage_view_tree" model="ir.ui.view">
        <field name="name">construction.project.stage.list</field>
        <field name="model">construction.project.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom" sample="1">
                <field name="sequence" widget="handle"/>
                <field name="name" placeholder="e.g. To Do"/>
                <field name="mail_template_id" optional="hide" context="{'default_model': 'construction.project'}"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company" options="{'no_create': True}"/>
                <field name="fold" optional="show"/>
            </list>
        </field>
    </record>

    <record id="construction_project_stage_view_form_quick_create" model="ir.ui.view">
        <field name="name">construction.project.stage.form.quick.create</field>
        <field name="model">construction.project.stage</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" placeholder="e.g. To Do"/>
                    <field name="fold"/>
                </group>
            </form>
        </field>
    </record>

    <record id="construction_project_stage_view_form" model="ir.ui.view">
        <field name="name">construction.project.stage.form</field>
        <field name="model">construction.project.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <h1><field name="name" placeholder="e.g. To Do"/></h1>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="mail_template_id" context="{'default_model': 'construction.project'}"/>
                            <field name="sequence" groups="base.group_no_one"/>
                        </group>
                        <group>
                            <field name="fold"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="construction_project_stage_view_kanban" model="ir.ui.view">
        <field name="name">construction.project.stage.kanban</field>
        <field name="model">construction.project.stage</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1" quick_create_view="sdlc_construction_management.construction_project_stage_view_form_quick_create">
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bolder mb-4"/>
                        <field name="mail_template_id" class="text-muted mb-2" invisible="not mail_template_id"/>
                        <field name="company_id" groups="base.group_multi_company" invisible="not company_id" class="mb-2"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="construction_project_stage_view_search" model="ir.ui.view">
        <field name="name">construction.project.stage.search</field>
        <field name="model">construction.project.stage</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Company" name="company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_project_stage" model="ir.actions.act_window">
        <field name="name">Project Stages</field>
        <field name="res_model">construction.project.stage</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No stages found. Let's create one!
            </p>
            <p>
                Define the steps your construction projects move through from creation to completion.
            </p>
        </field>
    </record>
</odoo>
