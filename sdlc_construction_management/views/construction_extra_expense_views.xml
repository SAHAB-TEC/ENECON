<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_construction_extra_expense_list" model="ir.ui.view">
        <field name="name">construction.extra.expense.list</field>
        <field name="model">construction.extra.expense</field>
        <field name="arch" type="xml">
            <list string="Extra Expenses" decoration-info="state == 'draft'"
                  decoration-success="state == 'approved'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="sub_project_id"/>
                <field name="date"/>
                <field name="expense_type"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_construction_extra_expense_form" model="ir.ui.view">
        <field name="name">construction.extra.expense.form</field>
        <field name="model">construction.extra.expense</field>
        <field name="arch" type="xml">
            <form string="Extra Expense">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="oe_highlight" invisible="state != 'confirmed'"
                            groups="sdlc_construction_management.group_construction_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('approved', 'cancelled')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state in ('draft', 'approved')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="sub_project_id"/>
                            <field name="expense_type"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="amount"/>
                            <field name="approved_by" invisible="state != 'approved'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_construction_extra_expense_search" model="ir.ui.view">
        <field name="name">construction.extra.expense.search</field>
        <field name="model">construction.extra.expense</field>
        <field name="arch" type="xml">
            <search string="Extra Expenses">
                <field name="name"/>
                <field name="project_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_type" string="Expense Type" context="{'group_by': 'expense_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_construction_extra_expense" model="ir.actions.act_window">
        <field name="name">Extra Expenses</field>
        <field name="res_model">construction.extra.expense</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record a new Extra Expense
            </p>
        </field>
    </record>
</odoo>
