<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_construction_quality_check_list" model="ir.ui.view">
        <field name="name">construction.quality.check.list</field>
        <field name="model">construction.quality.check</field>
        <field name="arch" type="xml">
            <list string="Quality Checks" decoration-success="state == 'pass'"
                  decoration-danger="state == 'fail'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="sub_project_id"/>
                <field name="check_type"/>
                <field name="date"/>
                <field name="inspector_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'in_progress'"
                       decoration-success="state == 'pass'"
                       decoration-danger="state == 'fail'"
                       decoration-warning="state == 'conditional'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_construction_quality_check_form" model="ir.ui.view">
        <field name="name">construction.quality.check.form</field>
        <field name="model">construction.quality.check</field>
        <field name="arch" type="xml">
            <form string="Quality Check">
                <header>
                    <button name="action_start" string="Start Inspection" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_pass" string="Pass" type="object"
                            class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_fail" string="Fail" type="object"
                            invisible="state != 'in_progress'"/>
                    <button name="action_conditional" string="Conditional Pass" type="object"
                            invisible="state != 'in_progress'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,pass"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="sub_project_id"/>
                            <field name="phase_id"/>
                            <field name="work_order_id"/>
                        </group>
                        <group>
                            <field name="check_type"/>
                            <field name="date"/>
                            <field name="inspector_id"/>
                            <field name="recheck_date" invisible="state not in ('fail', 'conditional')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Check Points">
                            <field name="check_line_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="standard"/>
                                    <field name="result"
                                           decoration-success="result == 'pass'"
                                           decoration-danger="result == 'fail'"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                        <page string="Results">
                            <group>
                                <field name="result_notes"/>
                                <field name="corrective_action"
                                       invisible="state not in ('fail', 'conditional')"/>
                            </group>
                        </page>
                        <page string="Documents">
                            <group>
                                <field name="document" filename="document_name"/>
                                <field name="document_name" invisible="1"/>
                            </group>
                            <field name="image_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="image" widget="image" options="{'size': [100, 100]}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_construction_quality_check_search" model="ir.ui.view">
        <field name="name">construction.quality.check.search</field>
        <field name="model">construction.quality.check</field>
        <field name="arch" type="xml">
            <search string="Quality Checks">
                <field name="name"/>
                <field name="project_id"/>
                <field name="inspector_id"/>
                <filter name="pass" string="Pass" domain="[('state', '=', 'pass')]"/>
                <filter name="fail" string="Fail" domain="[('state', '=', 'fail')]"/>
                <filter name="conditional" string="Conditional" domain="[('state', '=', 'conditional')]"/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_type" string="Check Type" context="{'group_by': 'check_type'}"/>
                    <filter name="group_state" string="Result" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_construction_quality_check" model="ir.actions.act_window">
        <field name="name">Quality Checks</field>
        <field name="res_model">construction.quality.check</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Quality Check
            </p>
        </field>
    </record>
</odoo>
