<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_housing_unit_type_list" model="ir.ui.view">
        <field name="name">housing.unit.type.list</field>
        <field name="model">housing.unit.type</field>
        <field name="arch" type="xml">
            <list string="Unit Types">
                <field name="name"/>
                <field name="unit_count"/>
            </list>
        </field>
    </record>

    <record id="view_housing_unit_type_form" model="ir.ui.view">
        <field name="name">housing.unit.type.form</field>
        <field name="model">housing.unit.type</field>
        <field name="arch" type="xml">
            <form string="Unit Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_units" icon="fa-building"
                                invisible="not unit_count">
                            <field name="unit_count" widget="statinfo" string="Units"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_housing_unit_type" model="ir.actions.act_window">
        <field name="name">Unit Types</field>
        <field name="res_model">housing.unit.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Unit Type
            </p>
            <p>
                Define the categories of accommodation units, e.g. Apartment, Trailer, Studio.
            </p>
        </field>
    </record>

</odoo>
