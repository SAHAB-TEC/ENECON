<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_project_form_enecon_daily_report" model="ir.ui.view">
        <field name="name">construction.project.form.enecon.daily.report</field>
        <field name="model">construction.project</field>
        <field name="inherit_id" ref="sdlc_construction_management.view_construction_project_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_rgb_view_daily_reports"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-calendar-check-o">
                    <field name="rgb_daily_report_count" widget="statinfo" string="Daily Reports"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
