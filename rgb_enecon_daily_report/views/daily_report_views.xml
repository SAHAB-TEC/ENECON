<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rgb_enecon_daily_report_list" model="ir.ui.view">
        <field name="name">rgb.enecon.daily.report.list</field>
        <field name="model">rgb.enecon.daily.report</field>
        <field name="arch" type="xml">
            <list string="Daily Reports"
                  decoration-success="state == 'approved'"
                  decoration-muted="state == 'new'">
                <field name="name"/>
                <field name="date"/>
                <field name="project_id"/>
                <field name="customer_id"/>
                <field name="work_hours"/>
                <field name="overtime_hours"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_rgb_enecon_daily_report_kanban" model="ir.ui.view">
        <field name="name">rgb.enecon.daily.report.kanban</field>
        <field name="model">rgb.enecon.daily.report</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bolder"/>
                        <div class="text-muted"><field name="project_id"/></div>
                        <div><field name="date"/></div>
                        <div class="mt-2"><field name="state" widget="badge"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_rgb_enecon_daily_report_form" model="ir.ui.view">
        <field name="name">rgb.enecon.daily.report.form</field>
        <field name="model">rgb.enecon.daily.report</field>
        <field name="arch" type="xml">
            <form string="Daily Report">
                <header>
                    <button
                        name="action_approve"
                        string="Approve"
                        type="object"
                        class="btn-primary"
                        groups="rgb_enecon_daily_report.group_rgb_enecon_daily_report_approver"
                        invisible="state != 'new'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,approved"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Approved" invisible="state != 'approved'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"
                                   readonly="state == 'approved'"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="customer_id" readonly="1"/>
                            <field name="location" readonly="1"/>
                        </group>
                        <group>
                            <field name="date" readonly="state == 'approved'"/>
                            <field name="stage_name" readonly="state == 'approved'"/>
                            <field name="tank_name" readonly="state == 'approved'"/>
                            <field name="work_type" readonly="state == 'approved'"/>
                            <field name="work_hours" readonly="state == 'approved'"/>
                            <field name="overtime_hours" readonly="state == 'approved'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Materials">
                            <field name="material_line_ids" readonly="state == 'approved'">
                                <list editable="bottom">
                                    <field name="product_id"
                                           options="{'no_create': True, 'no_create_edit': True}"
                                           domain="[('rgb_enecon_material', '=', True)]"/>
                                    <field name="quantity"/>
                                    <field name="uom_category_id" column_invisible="True"/>
                                    <field name="uom_id"
                                           options="{'no_create': True, 'no_create_edit': True}"
                                           domain="[('category_id', '=', uom_category_id)]"/>
                                    <field name="notes" optional="show"/>
                                </list>
                            </field>
                        </page>

                        <page string="Equipment">
                            <field name="equipment_line_ids" readonly="state == 'approved'">
                                <list editable="bottom">
                                    <field name="product_id"
                                           options="{'no_create': True, 'no_create_edit': True}"
                                           domain="[('rgb_enecon_equipment', '=', True)]"/>
                                    <field name="quantity"/>
                                    <field name="uom_category_id" column_invisible="True"/>
                                    <field name="uom_id"
                                           options="{'no_create': True, 'no_create_edit': True}"
                                           domain="[('category_id', '=', uom_category_id)]"/>
                                    <field name="notes" optional="show"/>
                                </list>
                            </field>
                        </page>

                        <page string="Transportation">
                            <field name="transport_line_ids" readonly="state == 'approved'">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="notes" optional="show"/>
                                </list>
                            </field>
                        </page>

                        <page string="Work Completed &amp; Images">
                            <field name="work_description"
                                   placeholder="Describe the work completed during the day..."
                                   readonly="state == 'approved'"/>
                            <field name="image_ids" readonly="state == 'approved'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="image" widget="image" options="{'size': [120, 120]}"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rgb_enecon_daily_report_search" model="ir.ui.view">
        <field name="name">rgb.enecon.daily.report.search</field>
        <field name="model">rgb.enecon.daily.report</field>
        <field name="arch" type="xml">
            <search string="Daily Reports">
                <field name="name"/>
                <field name="project_id"/>
                <field name="customer_id"/>
                <field name="date"/>
                <filter name="filter_new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_rgb_enecon_daily_report" model="ir.actions.act_window">
        <field name="name">Daily Reports</field>
        <field name="res_model">rgb.enecon.daily.report</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_rgb_enecon_daily_report_search"/>
    </record>

    <menuitem
        id="menu_rgb_enecon_daily_report"
        name="Daily Reports"
        parent="sdlc_construction_management.menu_construction_executions"
        action="action_rgb_enecon_daily_report"
        sequence="20"
        groups="sdlc_construction_management.group_construction_user"/>
</odoo>
